{
  "name": "@elementumai/edk",
  "version": "0.9.11",
  "description": "Elementum Development Kit — statically typed SDK for building Elementum apps, automations, and agents",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elementum-fde/edk.git"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./app": {
      "types": "./dist-sdk/src/entities/app/index.d.ts",
      "import": "./dist-sdk/src/entities/app/index.js"
    },
    "./elements": {
      "types": "./dist-sdk/src/entities/element/index.d.ts",
      "import": "./dist-sdk/src/entities/element/index.js"
    },
    "./core": {
      "types": "./dist-sdk/src/core/index.d.ts",
      "import": "./dist-sdk/src/core/index.js"
    },
    "./core/filters": {
      "types": "./dist-sdk/src/entities/shared/filters/index.d.ts",
      "import": "./dist-sdk/src/entities/shared/filters/index.js"
    },
    "./automations": {
      "types": "./dist-sdk/src/entities/automation/index.d.ts",
      "import": "./dist-sdk/src/entities/automation/index.js"
    },
    "./agents": {
      "types": "./dist-sdk/src/entities/agent/index.d.ts",
      "import": "./dist-sdk/src/entities/agent/index.js"
    },
    "./agents/skills": {
      "types": "./dist-sdk/src/entities/skill/index.d.ts",
      "import": "./dist-sdk/src/entities/skill/index.js"
    },
    "./charts": {
      "types": "./dist-sdk/src/entities/chart/index.d.ts",
      "import": "./dist-sdk/src/entities/chart/index.js"
    },
    "./visualFlows": {
      "types": "./dist-sdk/src/entities/visual-flow/index.d.ts",
      "import": "./dist-sdk/src/entities/visual-flow/index.js"
    },
    "./searchTables": {
      "types": "./dist-sdk/src/entities/search-table/index.d.ts",
      "import": "./dist-sdk/src/entities/search-table/index.js"
    },
    "./fileReaders": {
      "types": "./dist-sdk/src/entities/file-reader/index.d.ts",
      "import": "./dist-sdk/src/entities/file-reader/index.js"
    },
    "./approvalChains": {
      "types": "./dist-sdk/src/entities/approval-chain/index.d.ts",
      "import": "./dist-sdk/src/entities/approval-chain/index.js"
    },
    "./approvalProcesses": {
      "types": "./dist-sdk/src/entities/approval-chain/index.d.ts",
      "import": "./dist-sdk/src/entities/approval-chain/index.js"
    },
    "./tables": {
      "types": "./dist-sdk/src/entities/table/index.d.ts",
      "import": "./dist-sdk/src/entities/table/index.js"
    },
    "./tasks": {
      "types": "./dist-sdk/src/entities/task/index.d.ts",
      "import": "./dist-sdk/src/entities/task/index.js"
    },
    "./organization": {
      "types": "./dist-sdk/src/entities/organization/index.d.ts",
      "import": "./dist-sdk/src/entities/organization/index.js"
    },
    "./catalog": {
      "types": "./dist-sdk/src/catalog/index.d.ts",
      "import": "./dist-sdk/src/catalog/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "app": [
        "dist-sdk/src/entities/app/index.d.ts"
      ],
      "elements": [
        "dist-sdk/src/entities/element/index.d.ts"
      ],
      "core": [
        "dist-sdk/src/core/index.d.ts"
      ],
      "core/filters": [
        "dist-sdk/src/entities/shared/filters/index.d.ts"
      ],
      "automations": [
        "dist-sdk/src/entities/automation/index.d.ts"
      ],
      "agents": [
        "dist-sdk/src/entities/agent/index.d.ts"
      ],
      "agents/skills": [
        "dist-sdk/src/entities/skill/index.d.ts"
      ],
      "charts": [
        "dist-sdk/src/entities/chart/index.d.ts"
      ],
      "searchTables": [
        "dist-sdk/src/entities/search-table/index.d.ts"
      ],
      "visualFlows": [
        "dist-sdk/src/entities/visual-flow/index.d.ts"
      ],
      "fileReaders": [
        "dist-sdk/src/entities/file-reader/index.d.ts"
      ],
      "approvalChains": [
        "dist-sdk/src/entities/approval-chain/index.d.ts"
      ],
      "approvalProcesses": [
        "dist-sdk/src/entities/approval-chain/index.d.ts"
      ],
      "tables": [
        "dist-sdk/src/entities/table/index.d.ts"
      ],
      "tasks": [
        "dist-sdk/src/entities/task/index.d.ts"
      ],
      "organization": [
        "dist-sdk/src/entities/organization/index.d.ts"
      ],
      "catalog": [
        "dist-sdk/src/catalog/index.d.ts"
      ]
    }
  },
  "files": [
    "dist-sdk",
    "LICENSE"
  ],
  "scripts": {
    "sync:version": "tsx src/scripts/sync-cli-version.ts",
    "sync:skills": "tsx src/scripts/sync-skill-assets.ts",
    "check:skills": "tsx src/scripts/sync-skill-assets.ts --check",
    "clean:skills": "tsx src/scripts/sync-skill-assets.ts --clean",
    "sync:compatibility": "tsx src/scripts/sync-compatibility.ts",
    "check:release-context": "tsx src/scripts/release-context.ts v0.0.0 HEAD >/dev/null",
    "fetch:schema": "make -C provider fetch-schema",
    "generate:schema": "make -C provider generate-schema",
    "generate:graphql": "make -C provider generate-graphql",
    "build": "npm run build:sdk",
    "build:sdk": "rm -rf dist-sdk && tsc -p tsconfig.sdk.json",
    "build:cli": "npm run sync:version && npm run sync:skills && npm run sync:compatibility && rm -rf dist-cli && tsc -p tsconfig.cli.json",
    "prebuild:provider": "npm run generate:graphql",
    "build:provider": "go -C provider build .",
    "prebuild:bridge": "npm run generate:graphql",
    "build:bridge": "mkdir -p integration/.toolchain && go -C cmd/elementum build -o ../../integration/.toolchain/ei .",
    "build:go": "npm run build:provider && npm run build:bridge",
    "build:distribution": "npm --prefix distribution run build",
    "version": "npm run sync:version && npm run sync:skills && git add src/cli/version.ts src/cli/skills-assets.ts skills/user/*/SKILL.md",
    "build:binary:bun": "npm run build:cli && node dist-cli/src/scripts/build-bun-binary.js",
    "build:binary:bun:all": "npm run build:cli && node dist-cli/src/scripts/build-bun-binary.js --all",
    "local:setup": "bash integration/local-toolchain.sh",
    "local:refresh": "npm run build:sdk && npm run build:binary:bun",
    "elementum": "bash integration/tools/elementum-local.sh",
    "local:clone": "bash integration/tools/clone-golden.sh",
    "smoke:binary:bun": "node dist-cli/src/scripts/smoke-bun-binary.js",
    "smoke:binary:workspace": "node dist-cli/src/scripts/smoke-bun-binary.js --workspace-only",
    "prepare": "husky || true",
    "prepack": "npm run build:sdk",
    "pack:dry-run": "npm pack --dry-run",
    "pack:consumer": "npm run build:sdk && tsx src/scripts/test-package-consumer.ts",
    "release:local-sdk": "bash release/verify-local-sdk-prepare.sh",
    "test": "tsx src/scripts/test.ts",
    "test:unit": "npm run typecheck:ci && vitest run",
    "test:runtime": "vitest run",
    "check:parity": "tsx src/scripts/check-provider-parity.ts",
    "pretest:provider": "npm run generate:graphql",
    "test:provider": "go -C provider test -timeout=120s -parallel=10 ./internal/...",
    "pretest:provider:cover": "npm run generate:graphql",
    "test:provider:cover": "go -C provider test -v -cover -timeout=120s -parallel=10 ./internal/...",
    "pretest:bridge": "npm run generate:graphql",
    "test:bridge": "go -C cmd/elementum test -v -timeout=30s ./...",
    "test:backend-lock": "vitest run __tests__/integration/http-backend-lock.test.ts __tests__/integration/http-state-backend.test.ts",
    "test:go": "npm run test:provider && npm run test:bridge",
    "test:distribution": "npm --prefix distribution test",
    "test:watch": "vitest",
    "test:cli": "vitest run __tests__/cli",
    "test:binary": "npm run build:sdk && npm run build:binary:bun && npm run smoke:binary:bun",
    "test:integration": "node integration/run.mjs",
    "typecheck": "npm run typecheck:ci",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json && tsc --noEmit -p tsconfig.examples-check.json",
    "typecheck:src": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples-check.json",
    "typecheck:consumer": "tsc --noEmit -p tsconfig.package-consumer-check.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.typecheck-tests.json",
    "lint": "eslint src/cli src/internal/sdk-package.ts src/scripts/prepare-release-promotion.ts src/scripts/test-package-consumer.ts examples/package-consumer",
    "lint:all": "eslint .",
    "lint:generated": "eslint generated/",
    "check": "npm run typecheck && npm run lint && npm run check:release-context",
    "check:distribution": "npm --prefix distribution run check",
    "verify:distribution": "npm run check:distribution && npm run test:distribution && npm run build:distribution && git diff --exit-code -- distribution/generated distribution/public/schemas",
    "edk:canvas": "tsx --tsconfig tsconfig.examples-check.json src/scripts/edk-canvas.ts"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@cdktf/hcl2json": "^0.21.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.2",
    "@types/semver": "^7.8.0",
    "@vercel/blob": "^2.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bun": "^1.3.14",
    "commander": "^14.0.3",
    "eslint": "^9.39.4",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "openpgp": "^6.3.1",
    "tar": "^7.5.22",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.1",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "bun@1.3.14": true,
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
